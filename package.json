    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^22.0.0",
    "@xterm/headless": "^6.0.0",
    "electron": "^39.0.0",
    "typescript": "^5.6.0"
  }
